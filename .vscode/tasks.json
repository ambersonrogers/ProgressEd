{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar ProgressEd Completo (Backend + Frontend)",
      "type": "shell",
      "command": "node dev.js",
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Iniciar Apenas Backend (Porta 5000)",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Iniciar Apenas Frontend (Porta 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Executar Flutter Mobile (Windows/Chrome/Emulador)",
      "type": "shell",
      "command": "flutter run -d chrome",
      "options": {
        "cwd": "${workspaceFolder}/progressed_mobile"
      },
      "problemMatcher": []
    }
  ]
}
